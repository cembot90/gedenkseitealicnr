rules_version = '2';

// Sicherheitsregeln für die Gedenkseite.
// In der Firebase-Konsole unter Firestore > Regeln einfügen und veröffentlichen.
//
// Gedenkbuch und Lichter erscheinen sofort, Fotos erst nach Freigabe.
// Spamschutz: anonyme Anmeldung, ein Beitrag alle 30 Sekunden, keine Links.
// Admin (Freigeben, Ausblenden, Löschen über admin.html): nur cembot90@gmail.com mit Google-Anmeldung.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'cembot90@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function noLinks(s) {
      return !s.lower().matches('.*(https?://|www[.]|[a-z0-9-]+[.](com|net|org|ru|xyz|info|top|io|de|tr)([/ ]|$)).*');
    }

    function optionalText(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen && noLinks(data[field]));
    }

    function rateLimited() {
      return request.auth != null &&
        getAfter(/databases/$(database)/documents/ratelimits/$(request.auth.uid)).data.last == request.time;
    }

    function onlyApprovedChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']) &&
        request.resource.data.approved is bool;
    }

    match /ratelimits/{uid} {
      allow read: if false;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last == request.time;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last == request.time &&
        request.time > resource.data.last + duration.value(30, 's');
      allow delete: if false;
    }

    // Gedenkbuch: sofort sichtbar
    match /guestbook/{entryId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if rateLimited() &&
        request.resource.data.keys().hasOnly(['name', 'relation', 'message', 'lang', 'approved', 'createdAt']) &&
        request.resource.data.keys().hasAll(['message', 'approved', 'createdAt']) &&
        request.resource.data.approved == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 2 &&
        request.resource.data.message.size() <= 1500 &&
        noLinks(request.resource.data.message) &&
        optionalText(request.resource.data, 'name', 60) &&
        optionalText(request.resource.data, 'relation', 60) &&
        (!('lang' in request.resource.data) || request.resource.data.lang in ['de', 'tr']);
      allow update: if isAdmin() && onlyApprovedChanges();
      allow delete: if isAdmin();
    }

    // Lichter: sofort sichtbar, nur ein kurzer Name
    match /candles/{candleId} {
      allow read: if true;
      allow create: if rateLimited() &&
        request.resource.data.keys().hasOnly(['name', 'createdAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 40 &&
        noLinks(request.resource.data.name);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Geteilte Fotos: Vorschau + Angaben, erst nach Freigabe sichtbar
    match /photos/{photoId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if rateLimited() &&
        request.resource.data.keys().hasOnly(['name', 'caption', 'thumb', 'lang', 'approved', 'createdAt']) &&
        request.resource.data.keys().hasAll(['name', 'thumb', 'approved', 'createdAt']) &&
        request.resource.data.approved == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 60 &&
        noLinks(request.resource.data.name) &&
        optionalText(request.resource.data, 'caption', 140) &&
        request.resource.data.thumb is string &&
        request.resource.data.thumb.size() <= 160000 &&
        request.resource.data.thumb.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') &&
        (!('lang' in request.resource.data) || request.resource.data.lang in ['de', 'tr']) &&
        existsAfter(/databases/$(database)/documents/photoFull/$(photoId));
      allow update: if isAdmin() && onlyApprovedChanges();
      allow delete: if isAdmin();
    }

    // Große Fassung eines geteilten Fotos, nur einzeln abrufbar
    match /photoFull/{photoId} {
      allow get: if isAdmin() ||
        get(/databases/$(database)/documents/photos/$(photoId)).data.approved == true;
      allow list: if false;
      allow create: if rateLimited() &&
        request.resource.data.keys().hasOnly(['data', 'createdAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.data is string &&
        request.resource.data.data.size() <= 950000 &&
        request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') &&
        getAfter(/databases/$(database)/documents/photos/$(photoId)).data.approved == false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
